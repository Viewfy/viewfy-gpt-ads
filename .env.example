# Server-side only. Never commit real keys.
MOCK=0
OPENAI_API_KEY=
OPENAI_ADS_API_KEY=
APIFY_TOKEN=

# Disabled launch requests save the campaign for later and continue to Next Steps.
# Set to 1 only when real campaign submission is explicitly wanted.
LIVE_CAMPAIGN_SUBMISSION_ENABLED=0

# Optional. Defaults shown.
OPENAI_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2
HOST=127.0.0.1
PORT=9410
FRONTEND_ORIGIN=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/github/callback
CURSOR_API_KEY=
PIXEL_PUBLIC_URL=http://127.0.0.1:9410
